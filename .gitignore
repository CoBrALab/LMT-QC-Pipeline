# Python
__pycache__/
*.py[cod]
*$py.class

# uv-managed virtual environment
.venv/

# Byte-compiled / optimized files, distribution artifacts
build/
dist/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Pipeline run output (generated SQLite files, screenshots, reports) —
# not source, and can be large; users regenerate these by running the
# pipeline against their own data.
*_processed.sqlite
lmt_gap_fill_*.sqlite
lmt_binary_search_*.sqlite
lmt_qc_sampler_*.sqlite
lmt_qc_validator_*.sqlite
LMT_Summary_*.txt
lmt_qc_validator_*.txt
_binsearch_tmp/
Screenshots/

# analysis/ layer: generated CSV outputs, not source. Users regenerate
# these by running analysis/scripts/run_analysis.py against their
# own config/data.
analysis/outputs/*
!analysis/outputs/.gitkeep
